{
  "schema_version": "1.0.0",
  "policy_id": "ajackti-core-policy",
  "description": "Shared core policy across all domain profiles in the AJACKTI Agent Harness.",
  "execution_model": {
    "mode": "external-first",
    "worker_cli": "agy",
    "agy_metadata_scope": "agy_workers_and_all_reviewers",
    "coordinator_role": "chatgpt-coordinates-and-final-reviews-only",
    "allow_local_fallback": false,
    "allow_internal_coding_without_exception": false,
    "workflow_selection": {
      "worker_selector_env_var": "WORKFLOW_WORKER",
      "allowed_workers": [
        "agy",
        "devin"
      ],
      "default_worker_when_unset": "agy",
      "context_selector_env_var": "WORKFLOW_CONTEXT",
      "allowed_contexts": [
        "lean",
        "compact",
        "full"
      ],
      "default_context_when_unset": "lean",
      "exact_match_only": true,
      "selection_owner": "coordinator",
      "compact_trims_only": "prompt_boilerplate",
      "compact_preserves_verbatim_contract": true,
      "compact_preserves_full_scoped_source": true,
      "lean_uses_compact_prompt": true,
      "lean_preserves_verbatim_contract": true,
      "lean_preserves_full_scoped_source": true,
      "runtime_context_and_proof_owner": "upstream_runner",
      "reviewer_worker": "agy",
      "reviewer_model_env_var": "AGY_MODEL",
      "automatic_failover": false,
      "runtime_quota_polling": false,
      "shares_task_retry_ledger": true,
      "reset_retry_ledger_on_worker_change": false,
      "reset_retry_ledger_on_context_change": false,
      "devin_requires_recent_successful_generation": true,
      "claim_numeric_devin_quota": false,
      "opencode_role": "probe_only"
    },
    "model_selection": {
      "selector_env_var": "AGY_MODEL",
      "allowed_models": [
        "claude-opus-5-5-high",
        "gemini-4-argon-high"
      ],
      "exact_match_only": true,
      "preferred_model": "claude-opus-5-5-high",
      "fallback_model": "gemini-4-argon-high",
      "default_model_when_unset": "gemini-4-argon-high",
      "selection_owner": "coordinator",
      "refresh_per_task": [
        "quota",
        "auth",
        "availability"
      ],
      "quota_command": "agy --print /usage",
      "record_actual_query_usage": true,
      "zero_tool_probe_proves": "availability_only"
    },
    "pinned_effort": "high",
    "effort_slug_fallback": "-high",
    "permission_mode": "request-review",
    "resume_worker": false,
    "required_runner_flags": [
      "--no-resume-worker",
      "--context-mode"
    ],
    "forbid_unsupported_models": true,
    "forbid_effort_override": true
  },
  "worker_validation": {
    "applies_to": "agy_workers_and_all_reviewers",
    "require_exit_zero": true,
    "require_exact_init_model": "selected_model",
    "require_init_permission_mode": "request-review",
    "missing_permission_mode_blocks": true,
    "require_same_selected_model_for_worker_and_reviewers": true,
    "required_result_status": "SUCCESS",
    "require_nonempty_response": true,
    "forbid_denial": true,
    "require_init_effort_high_or_flag_and_slug": true,
    "fail_closed_conditions": [
      "missing_cli",
      "missing_model",
      "model_mismatch",
      "permission_denial",
      "timeout",
      "quota_error",
      "auth_error",
      "provider_error",
      "availability_error",
      "incomplete_proof",
      "missing_permission_metadata"
    ]
  },
  "devin_worker_validation": {
    "pinned_model": "swe-1-6-slow",
    "trajectory_schema_version": "ATIF-v1.7",
    "cli_permission_mode": "auto",
    "proof_permission_mode": "Normal",
    "forbid_request_review_permission_claim": true,
    "claim_effort_high": false,
    "permission_config": "deny_all",
    "pre_tool_use_hook": "unconditional_exit_2",
    "pre_tool_use_exit_code": 2,
    "require_isolated_cwd": true,
    "max_tool_calls": 0,
    "max_observations": 0,
    "require_fresh_session_per_attempt": true,
    "lean_tool_schema_validation_scope": "devin_lean_only",
    "claim_lean_tool_schema_checks_for_agy_or_non_lean": false,
    "lean_require_per_session_disabled_tools": true,
    "lean_tool_definitions_path": "agent.tool_definitions",
    "lean_allowed_tool_definitions": [
      "mcp_call_tool",
      "mcp_list_servers",
      "mcp_list_tools",
      "mcp_read_resource",
      "skill"
    ],
    "lean_tool_definitions_rule": "well_formed_unique_name_nonempty_subset",
    "lean_block_invalid_tool_definitions_before_apply": true,
    "schema_hiding_authorizes_tools": false,
    "lean_remaining_tools_denied_by_config_and_pre_tool_use_exit_2": true,
    "handoff_format": "strict_json_files",
    "handoff_path_policy": "exact_scoped_replacements_only",
    "apply_handoff_only_after_proof_validation": true,
    "require_precondition_hashes": true,
    "require_atomic_rollback": true,
    "allow_deletions": false,
    "allow_symlinks": false,
    "allow_path_aliases": false,
    "execute_returned_commands": false,
    "require_exact_final_response_stdout_match": true,
    "allowed_leading_stdout_escape": "ESC[?2004l",
    "max_leading_stdout_escapes": 1,
    "max_trailing_stdout_newlines": 1,
    "require_exit_zero": true,
    "forbid_permission_denial": true,
    "forbid_quota_error": true,
    "forbid_auth_error": true,
    "forbid_timeout": true,
    "devin_usage_totals_key": "usage_totals.devin",
    "agy_usage_totals_key": "usage_totals.gemini",
    "separate_usage_totals_from_agy": true
  },
  "pipeline": {
    "ordered_stages": [
      "external_worker",
      "repo_native_mechanical_checks",
      "jev_typed_evidence_triage",
      "fresh_pinned_reviewers",
      "chatgpt_final_review"
    ],
    "jev": {
      "binary": "jev-pool",
      "version": "jev-1.13.0",
      "role": "typed_evidence_and_uncertainty_triage_only",
      "allow_file_edits": false
    },
    "reviewers": {
      "task_min_reviewers": 1,
      "quant_min_reviewers": 2,
      "fresh_same_model_semantics": "independent_not_stronger"
    },
    "max_reworks": 2,
    "retry_policy": {
      "owner": "coordinator",
      "max_extra_worker_executions": 2,
      "counts_internal_reworks": true,
      "counts_cross_run_restarts": true,
      "counts_model_restarts": true,
      "reset_on_model_change": false,
      "reset_on_auth_change": false,
      "max_reworks_rule": "reduce_to_remaining_after_restart_reservation",
      "max_reworks_floor": 0,
      "max_reworks_ceiling": 2,
      "require_original_snapshot": true,
      "require_aggregate_review": true,
      "terminal_conditions": [
        "model_mismatch",
        "permission_denial"
      ],
      "reassessment_eligible_conditions": [
        "quota_error",
        "auth_error",
        "availability_error"
      ],
      "allow_account_key_billing_changes": false,
      "automatic_failover": false
    },
    "default_worker_timeout_seconds": 1800,
    "reporting": {
      "required_fields": [
        "verdict",
        "actual_model",
        "worker_provider",
        "worker_model",
        "reviewer_model",
        "context_mode",
        "files",
        "actual_check_exit_codes",
        "confidence_below_100_percent",
        "residual_uncertainty"
      ],
      "separate_devin_and_agy_usage": true,
      "devin_usage_totals_key": "usage_totals.devin",
      "agy_usage_totals_key": "usage_totals.gemini",
      "max_confidence_percent": 99
    }
  },
  "runners": {
    "task": {
      "runner_id": "antigravity-task-runner",
      "work_kind": "task",
      "relative_script_path": "antigravity-task-runner/scripts/run_workflow.py",
      "supported_flags": [
        "--id",
        "--workspace",
        "--scope",
        "--verify-cmd",
        "--output-dir",
        "--min-reviewers",
        "--max-reworks",
        "--worker-timeout",
        "--no-resume-worker",
        "--context-mode"
      ],
      "positional_packet": true,
      "execution_enabled": true
    },
    "quant": {
      "runner_id": "antigravity-sol-quant-runner",
      "work_kind": "quant",
      "relative_script_path": "antigravity-sol-quant-runner/scripts/run_workflow.py",
      "execution_enabled": false,
      "blocked_status": "BLOCKED",
      "blocked_reason": "Quant tasks require a reviewer proven stronger than the selected worker model; no approved stronger-reviewer integration exists in the current runner, and distinct provider or model names do not prove stronger review (fresh reviewers are independent, not stronger).",
      "unblock_requirement": "Configure and prove an approved stronger-reviewer integration in antigravity-sol-quant-runner, followed by explicit user approval to unblock in core/policy.json. Distinct provider or model names (including Devin swe-1-6-slow or agy claude-opus-5-5-high / gemini-4-argon-high) do not prove stronger review and do not unblock quant."
    }
  },
  "protected_boundaries": {
    "forbidden_scope_prefixes": [
      ".git",
      ".env",
      "secrets",
      "credentials"
    ],
    "protected_filenames": [
      ".env",
      ".env.local",
      ".env.production",
      "id_rsa",
      "credentials.json"
    ],
    "harness_protected_files": [
      "core/policy.json",
      "harness.json",
      "AGENTS.md",
      "quant/AGENTS.md"
    ],
    "require_explicit_approval_for": [
      "credentials",
      "endpoints",
      "live_configs",
      "leverage",
      "margin",
      "safety_gates"
    ],
    "require_output_dir_outside_workspace": true
  },
  "quant_policy": {
    "allow_quant_under_general_task": false,
    "allow_classifier_override_of_quant_seam": false,
    "required_invariants": [
      "causal_provenance",
      "realistic_friction",
      "long_short_parity",
      "deterministic_seeds_and_tests",
      "stronger_reviewer"
    ],
    "quant_seam_keywords": [
      "pnl",
      "funding",
      "liquidation",
      "backtest",
      "sharpe",
      "drawdown",
      "leverage",
      "margin",
      "slippage",
      "risk-engine",
      "financial-math"
    ]
  }
}
